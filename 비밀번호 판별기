def password_check(pw):
    if len(pw) >= 8:
        print("강함")
    elif len(pw) >= 4:
        print("중간")
    elif len(pw) <= 3:
        print("약함")

password_check("abc")        # → 약함
password_check("hello")      # → 중간
password_check("superhero")  # → 강함





